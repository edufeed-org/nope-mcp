# AMB relay URL(s), comma-separated. The amb-relay now serves ALL content
# types — educational resources (30142), long-form articles (30023), wikis
# (30818), transferkiosk projects/measures (30143/30144), NKBIP-01 scientific
# publications (30040 indices + 30041 sections), and NIP-52 calendar events —
# so a single relay covers search_content and search_calendar_events. Use
# ws://localhost:3337 for the local docker-compose relay in this repo, or
# wss://dev.amb-relay.edufeed.org for dev.
AMB_RELAYS=wss://relay.edufeed.org

# Additional AMB relays that are selectable per call but NOT searched by
# default. search_content/search_resources/get_resource accept a `relays`
# parameter naming relays from AMB_RELAYS ∪ AMB_EXTRA_RELAYS; list_relays
# advertises both groups. E.g. the OERSI and SODIX aggregation relays:
# AMB_EXTRA_RELAYS=wss://oersi.edufeed.org,wss://sodix.edufeed.org
#
# Over the HTTP transport these two lists also form the catalog that the
# `?relays=` connector-URL parameter selects from (see README, "Choosing a
# connector's default relays"). Every relay here answers to its full URL, its
# hostname, and the first label of its hostname — so the line above makes
# /mcp?relays=sodix and /mcp?relays=relay,oersi valid connection URLs.

# Server private key for the ContextVM/Nostr transport identity (nsec or hex).
# Only needed for src/index.ts — not for the stdio or HTTP transports.
SERVER_PRIVATE_KEY=nsec1...

# Nostr relays for ContextVM communication (comma-separated).
# Only needed for src/index.ts.
RELAYS=wss://relay.contextvm.org,wss://cvm.otherstuff.ai

# AMB author follow sets (comma-separated naddr identifiers of NIP-51
# kind 30000 sets) — populates the list_known_authors directory.
# AMB_AUTHOR_SETS=

# Calendar relay URL(s), comma-separated. OPTIONAL: the amb-relay serves
# NIP-52 calendar events itself, so this defaults to the same relay as
# AMB_RELAYS. Only set it for split deployments with a dedicated calendar relay.
# CALENDAR_RELAYS=wss://relay.edufeed.org

# Calendar author follow sets (comma-separated naddr identifiers)
# CALENDAR_AUTHOR_SETS=

# Frontend base URL (no trailing slash). When set, search_resources and
# get_resource include a `url` field per resource pointing to the
# corresponding edufeed-app page (e.g. https://app.edufeed.org/<naddr>),
# letting LLM clients render direct clickable links.
# EDUFEED_APP_BASE_URL=https://app.edufeed.org

# --- extract_metadata tool ---
# Anthropic API key. When set, the extract_metadata tool grounds SKOS-typed
# fields in the configured vocabularies via an LLM call. When absent the
# tool degrades gracefully to OpenGraph-only output.
# ANTHROPIC_API_KEY=

# Override the default Anthropic model (defaults to claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Default SKOS schemes for extract_metadata, as a JSON map:
#   { "<form-field-name>": "<scheme-uri>" }
# Used when the caller does not pass skosSchemes explicitly.
# SKOS_SCHEMES={"learningResourceType":"https://w3id.org/kim/hcrt/scheme"}

# --- HTTP transport (optional third entry point: `node dist/http.js`) ---
# Port to bind; default 3000.
# HTTP_PORT=3000
# Bind host; default 0.0.0.0. Set 127.0.0.1 if only your reverse proxy needs access.
# HTTP_HOST=0.0.0.0
# Comma-separated Host header allow-list (DNS-rebinding protection).
# Leave unset to disable.
# HTTP_ALLOWED_HOSTS=mcp.example.org,localhost
# Comma-separated Origin allow-list. Leave unset to allow any origin.
# HTTP_ALLOWED_ORIGINS=https://claude.ai,https://example.org

# --- OAuth resource server (HTTP transport) ---
# Keycloak realm issuer.
# OAUTH_ISSUER=https://auth.edufeed.org/realms/edufeed
# Comma-separated audiences; a token whose aud contains ANY of them is
# accepted. Default keeps the legacy `amb-mcp` audience Keycloak still issues.
# OAUTH_AUDIENCE=nope-mcp,amb-mcp
# OAUTH_JWKS_URI defaults to <issuer>/protocol/openid-connect/certs
# OAUTH_JWKS_URI=
# The PRM `resource` is derived per request from X-Forwarded-Proto/Host
# (RFC 9728): /.well-known/oauth-protected-resource -> https://<host>/,
# /.well-known/oauth-protected-resource/mcp -> https://<host>/mcp.
# OAUTH_RESOURCE_URL is only the fallback for a host not in HTTP_ALLOWED_HOSTS.
# OAUTH_RESOURCE_URL=https://mcp.amb.edufeed.org/mcp

# --- License policy ---
# Searches return only openly licensed learning resources (CC0, Public Domain,
# CC BY, CC BY-SA). Set to false to return every resource. Default: true.
# OPEN_LICENSES_ONLY=true

# --- search_passages tool (spell-scoped RAG) ---
# Comma-separated `wss://relay=https://indexer` pairs mapping each AMB relay
# to its amb-indexer base URL. Enables search_passages; unset disables it.
# INDEXER_ENDPOINTS=wss://relay.edufeed.org=https://indexer.edufeed.org
# Bearer token for the indexer's /search_chunks (shared default for all
# endpoints above).
# INDEXER_API_TOKEN=
# Per-relay token overrides as `wss://relay=token` pairs — each deployed
# indexer instance has its own token. Overrides INDEXER_API_TOKEN per relay;
# every INDEXER_ENDPOINTS entry must be covered by one of the two.
# INDEXER_API_TOKENS=wss://oersi.edufeed.org=abc,wss://sodix.edufeed.org=def
# Relays to fetch kind-777 spells (and kind-3 contact lists) from.
# Defaults to wss://relay.edufeed.org.
# SPELL_RELAYS=wss://relay.edufeed.org

# --- docker-compose bundled stack ---
# Token for the embedding service used by the local test relay (docker-compose.yml).
# Only needed when running the bundled compose stack for development.
EMBED_TOKEN=
